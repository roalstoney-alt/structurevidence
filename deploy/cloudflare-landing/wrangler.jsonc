{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "structevidence-commercial",
  "main": "worker.js",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PUBLIC_ORIGINS": "https://structevidence.com",
    "TEAM_DOMAIN": "https://structevidence.cloudflareaccess.com"
  },
  "d1_databases": [
    {
      "binding": "CUSTOMER_CASES_DB",
      "database_name": "structurevidence-customer-cases",
      "database_id": "aee10591-536a-47af-8ee0-957551ba2360",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_INTAKE_RATE_LIMITER",
      "namespace_id": "842001",
      "simple": {
        "limit": 5,
        "period": 10
      }
    }
  ],
  "routes": [
    {
      "pattern": "structevidence.com",
      "custom_domain": true
    },
    {
      "pattern": "www.structevidence.com",
      "custom_domain": true
    }
  ]
}
