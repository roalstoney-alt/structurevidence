{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "status": {
      "enum": [
        "PASS",
        "PARTIAL",
        "FAIL",
        "BLOCKED",
        "NOT_APPLICABLE",
        "NOT_EVALUATED"
      ]
    }
  },
  "required": [
    "gate_id",
    "status",
    "validator",
    "rule_version",
    "evaluated_at",
    "evidence_refs",
    "computed_facts",
    "reason"
  ],
  "type": "object"
}
