{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structurevidence.org/protocol/claim-match/schema-v0.1.json",
  "title": "CLAIM_MATCH_CLASS_v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["match_class", "claim_ids", "equivalence_result", "unresolved_portion"],
  "properties": {
    "match_class": {"enum": ["EXACT", "ISOMORPHIC", "PARTIAL", "NONE"]},
    "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "equivalence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["same_subject", "same_predicate", "same_evidence_threshold", "same_scope", "same_temporal_meaning", "same_decision_implication"],
      "properties": {
        "same_subject": {"type": "boolean"},
        "same_predicate": {"type": "boolean"},
        "same_evidence_threshold": {"type": "boolean"},
        "same_scope": {"type": "boolean"},
        "same_temporal_meaning": {"type": "boolean"},
        "same_decision_implication": {"type": "boolean"}
      }
    },
    "equivalence_result": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
    "unresolved_portion": {"type": ["string", "null"]}
  }
}
