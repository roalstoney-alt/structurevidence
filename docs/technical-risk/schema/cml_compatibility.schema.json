{
  "$id": "https://structevidence.com/schema/cml/compatibility/v0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dimension": {
      "type": "string"
    },
    "evidence_or_test": {
      "type": "string"
    },
    "state": {
      "enum": [
        "MATCH",
        "ACCEPTABLE_DIFFERENCE",
        "MISMATCH",
        "UNKNOWN",
        "REQUIRES_TEST",
        "NOT_APPLICABLE"
      ],
      "type": "string"
    }
  },
  "required": [
    "dimension",
    "state",
    "evidence_or_test"
  ],
  "title": "CML Compatibility Cell",
  "type": "object"
}
