          "enum": [
            "PROCEED_TO_PHASE_C",
            "PROCEED_TO_PHASE_C_HIGH_PRIORITY",
            "CONTINUE_DESK_RESEARCH",
            "MONITOR",
            "PUBLIC_EVIDENCE_SUGGESTS_COMPETITIVE_RESOLUTION",
            "PUBLIC_EVIDENCE_SUGGESTS_PRODUCT_PHASED_OUT",
            "INSUFFICIENT_PUBLIC_EVIDENCE",
