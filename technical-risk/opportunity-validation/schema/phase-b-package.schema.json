            "DIRECT_PUBLIC_EVIDENCE",
            "DERIVED_FACT",
            "INDIRECT_PUBLIC_SIGNAL",
            "TECHNICAL_INFERENCE",
            "ENGINEERING_JUDGMENT",
            "IMPROVEMENT_HYPOTHESIS",
