{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structurevidence.org/schema/case-watch/daily-observation-v1.json",
  "title": "StructureEvidence Daily Case Watch Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id", "case_id", "observed_at", "knowledge_time", "event_time",
    "source_publication_time", "source_url", "source_title", "publisher", "source_type",
    "source_accessibility", "claim", "evidence_summary", "evidence_effect", "supports_state",
    "weakens_state", "resolves_unknown", "creates_new_unknown", "counter_evidence",
    "qualification_level", "production_status", "deployment_status", "operating_history_status",
    "replication_status", "procurement_status", "standard_regulatory_status", "economic_fields",
    "verification_required", "weekly_review_required", "reason", "next_observable",
    "research_authorization", "public_state_mutated"
  ],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "case_id": {"enum": ["CML-PDRE-001", "SE-BESS-SODIUM-001", "SE-ONC-NSQNSCLC-CN-001", "NEW_CANDIDATE", "NON_CASE_RELEVANT", "IRRELEVANT"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "knowledge_time": {"type": "string", "format": "date-time"},
    "event_time": {"type": ["string", "null"]},
    "source_publication_time": {"type": ["string", "null"]},
    "source_url": {"type": "string", "minLength": 1},
    "source_title": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "source_accessibility": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "evidence_summary": {"type": "string", "minLength": 1},
    "evidence_effect": {"enum": ["NO_STATE_CHANGE", "STRENGTHENS_EXISTING_STATE", "WEAKENS_EXISTING_STATE", "RESOLVES_UNKNOWN", "CREATES_CONTRADICTION", "POTENTIAL_STATE_TRANSITION"]},
    "supports_state": {"type": "array", "items": {"type": "string"}},
    "weakens_state": {"type": "array", "items": {"type": "string"}},
    "resolves_unknown": {"type": "array", "items": {"type": "string"}},
    "creates_new_unknown": {"type": "array", "items": {"type": "string"}},
    "counter_evidence": {"type": "string"},
    "qualification_level": {"type": "string"},
    "production_status": {"type": "string"},
    "deployment_status": {"type": "string"},
    "operating_history_status": {"type": "string"},
    "replication_status": {"type": "string"},
    "procurement_status": {"type": "string"},
    "standard_regulatory_status": {"type": "string"},
    "economic_fields": {"type": "object"},
    "verification_required": {"type": "boolean"},
    "weekly_review_required": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1},
    "next_observable": {"type": "string", "minLength": 1},
    "research_authorization": {"const": "L0_REUSE"},
    "public_state_mutated": {"const": false}
  }
}
