{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://structurevidence.org/schemas/se-frr/request.v0.1.json", "title": "SE Request v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "submitted_at", "requester_ref", "subject_text", "linked_subject_id", "question", "decision_context", "urgency", "visibility", "payment_status", "research_status", "linked_state_id", "outcome_status", "provenance"],
  "properties": {
    "schema_version": {"const": "SE_REQUEST_v0.1"}, "request_id": {"type": "string", "pattern": "^SE-REQ-[0-9]{8}-[0-9]{6}$"}, "submitted_at": {"$ref": "#/$defs/timestamp"},
    "requester_ref": {"type": "string", "minLength": 1}, "subject_text": {"type": "string", "minLength": 1}, "linked_subject_id": {"type": ["string", "null"]}, "question": {"type": "string", "minLength": 1}, "decision_context": {"type": "string", "minLength": 1}, "urgency": {"type": "string", "minLength": 1},
    "visibility": {"const": "CUSTOMER_PRIVATE"}, "payment_status": {"enum": ["NOT_REQUIRED", "UNPAID", "PENDING", "PAID", "REFUNDED"]},
    "research_status": {"enum": ["SUBMITTED", "TRIAGE", "ACCEPTED", "WAITING_FOR_PAYMENT", "RESEARCHING", "EVIDENCE_REVIEW", "STATE_CREATED", "DELIVERED", "OUTCOME_PENDING", "CLOSED", "REJECTED"]},
    "linked_state_id": {"type": ["string", "null"]}, "outcome_status": {"enum": ["NOT_REQUESTED", "PENDING", "REPORTED", "VERIFIED", "CLOSED"]}, "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {"timestamp": {"type": "string", "format": "date-time"}, "provenance": {"type": "object", "additionalProperties": false, "required": ["repository", "commit_sha", "source_object", "created_by", "method_version", "recorded_at", "supersedes", "superseded_by"], "properties": {"repository": {"type": "string", "minLength": 1}, "commit_sha": {"type": ["string", "null"]}, "source_object": {"type": ["string", "null"]}, "created_by": {"type": "string", "minLength": 1}, "method_version": {"type": "string", "minLength": 1}, "recorded_at": {"$ref": "#/$defs/timestamp"}, "supersedes": {"type": ["string", "null"]}, "superseded_by": {"type": ["string", "null"]}}}}
}
