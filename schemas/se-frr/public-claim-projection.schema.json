{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structevidence.com/schemas/se-frr/public-claim-projection.schema.json",
  "title": "PublicClaimProjection",
  "type": "object",
  "additionalProperties": false,
  "required": ["CLAIM", "SCOPE", "AS_OF", "FRESHNESS_STATUS", "STATE", "SUPPORTS", "DOES_NOT_SUPPORT", "QUALIFYING_RECORDS", "REJECTED_OR_COUNTER", "SEARCH_PROVENANCE", "SOURCE_ACCESS_STATUS", "DIRECT_INQUIRY_STATUS", "VERIFICATION_DEPTH", "OPEN_GAP_IF_UNKNOWN", "NEXT_MINIMUM_VERIFICATION", "NOT_A", "CLAIM_ID", "VERSION", "determination", "evidence_as_of", "knowledge_as_of", "decision_sentence", "citation_text", "render_locale", "expression", "boundary_complete", "claim_id", "canonical_subject_id", "canonical_state_refs", "canonical_evidence_refs", "version", "projection_hash", "stable_url"],
  "properties": {
    "CLAIM": { "type": "string", "minLength": 1 },
    "SCOPE": { "type": "object", "required": ["subject", "technical_boundary", "deployment_class", "jurisdiction", "attribution_scope", "time_boundary", "population_scope"] },
    "AS_OF": { "type": "string", "format": "date-time" },
    "FRESHNESS_STATUS": { "enum": ["CURRENT", "AGING", "STALE", "UNASSESSED"] },
    "STATE": { "enum": ["KNOWN", "ATTRIBUTABLE_ONLY", "UNKNOWN", "NOT_ESTABLISHED", "NOT_FOUND_WITHIN_SCOPE", "CONFLICTED"] },
    "SUPPORTS": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "DOES_NOT_SUPPORT": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "QUALIFYING_RECORDS": { "type": "array", "items": { "type": "string" } },
    "REJECTED_OR_COUNTER": { "type": "array", "items": { "type": "string" } },
    "SEARCH_PROVENANCE": { "type": "object" },
    "SOURCE_ACCESS_STATUS": { "type": "array", "minItems": 1 },
    "DIRECT_INQUIRY_STATUS": { "type": "string" },
    "VERIFICATION_DEPTH": { "enum": ["V0_LIBRARY_ONLY", "V1_PUBLIC_SEARCH", "V2_PRIMARY_SOURCE_SEARCH", "V3_RESTRICTED_OR_PAID_SOURCE_CHECK", "V4_DIRECT_WRITTEN_INQUIRY", "V5_INDEPENDENT_THIRD_PARTY_VERIFICATION"] },
    "OPEN_GAP_IF_UNKNOWN": { "type": "array", "items": { "type": "string" } },
    "NEXT_MINIMUM_VERIFICATION": { "type": "string", "minLength": 1 },
    "NOT_A": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "CLAIM_ID": { "type": "string", "pattern": "^SE-CLAIM-" },
    "VERSION": { "type": "integer", "minimum": 1 },
    "determination": { "type": "object", "required": ["state", "supports", "does_not_support"] },
    "evidence_as_of": { "type": "string", "format": "date-time" },
    "knowledge_as_of": { "type": "string", "format": "date-time" },
    "decision_sentence": { "type": "string", "minLength": 1 },
    "citation_text": { "type": "string", "minLength": 1 },
    "render_locale": { "enum": ["EN", "ZH-CN", "ES"] },
    "expression": { "type": "object", "required": ["expression_projection_version", "render_locale", "claim_id", "version", "as_of", "knowledge_as_of", "scope", "determination", "verification", "next_minimum_verification", "boundary_complete", "stable_url", "projection_hash", "decision_sentence", "short_summary", "citation_text"] },
    "boundary_complete": { "const": true },
    "claim_id": { "type": "string", "pattern": "^SE-CLAIM-" },
    "canonical_subject_id": { "type": "string" },
    "canonical_state_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "canonical_evidence_refs": { "type": "array", "items": { "type": "string" } },
    "version": { "type": "integer", "minimum": 1 },
    "projection_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stable_url": { "type": "string", "format": "uri" }
  }
}
