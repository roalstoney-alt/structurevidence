{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://structurevidence.org/schemas/se-frr/outcome.v0.1.json", "title": "SE Outcome v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "outcome_id", "request_id", "subject_id", "state_id_used", "reported_at", "action", "action_at", "reported_result", "verification_status", "supporting_evidence_refs", "commercial_result", "technical_result", "authorization_for_public_use", "visibility", "created_at", "provenance"],
  "properties": {
    "schema_version": {"const": "SE_OUTCOME_v0.1"}, "outcome_id": {"type": "string", "pattern": "^SE-OUT-[0-9]{8}-[0-9]{6}$"}, "request_id": {"type": "string", "minLength": 1}, "subject_id": {"type": "string", "pattern": "^SE-SUBJ-[0-9]{6}$"}, "state_id_used": {"type": "string", "minLength": 1},
    "reported_at": {"$ref": "#/$defs/timestamp"}, "action": {"type": "string", "minLength": 1}, "action_at": {"$ref": "#/$defs/timestamp"}, "reported_result": {"type": "string", "minLength": 1}, "verification_status": {"enum": ["UNVERIFIED", "SUPPORTED", "CONTESTED", "VERIFIED"]},
    "supporting_evidence_refs": {"$ref": "#/$defs/strings"}, "commercial_result": {"type": ["string", "null"]}, "technical_result": {"type": ["string", "null"]}, "authorization_for_public_use": {"type": "boolean"},
    "visibility": {"enum": ["PUBLIC", "CUSTOMER_PRIVATE"]}, "created_at": {"$ref": "#/$defs/timestamp"}, "provenance": {"$ref": "#/$defs/provenance"}
  },
  "allOf": [{"if": {"properties": {"visibility": {"const": "PUBLIC"}}}, "then": {"properties": {"authorization_for_public_use": {"const": true}}}}],
  "$defs": {"strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "timestamp": {"type": "string", "format": "date-time"}, "provenance": {"type": "object", "additionalProperties": false, "required": ["repository", "commit_sha", "source_object", "created_by", "method_version", "recorded_at", "supersedes", "superseded_by"], "properties": {"repository": {"type": "string", "minLength": 1}, "commit_sha": {"type": ["string", "null"]}, "source_object": {"type": ["string", "null"]}, "created_by": {"type": "string", "minLength": 1}, "method_version": {"type": "string", "minLength": 1}, "recorded_at": {"$ref": "#/$defs/timestamp"}, "supersedes": {"type": ["string", "null"]}, "superseded_by": {"type": ["string", "null"]}}}}
}
