{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structurevidence.org/schemas/se-frr/demand-signal.v0.1.json",
  "title": "SE Demand Signal DSR v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signal_id", "observed_at", "platform", "source_url", "author_public_id", "author_public_name", "organization_public_name", "signal_text_excerpt", "object_detected", "pain_detected", "action_detected", "decision_context", "mapped_subject_id", "mapped_state_id", "score_components", "real_decision_score", "score_class", "contactability", "recommended_action", "contact_status", "response_status", "request_id", "privacy_classification", "created_at"],
  "properties": {
    "schema_version": {"const": "DSR_v0.1"},
    "signal_id": {"type": "string", "pattern": "^SE-DSR-[0-9]{8}-[A-F0-9]{12}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "platform": {"type": "string", "minLength": 1, "maxLength": 40},
    "source_url": {"type": "string", "pattern": "^https://", "maxLength": 2000},
    "author_public_id": {"type": ["string", "null"], "maxLength": 300},
    "author_public_name": {"type": ["string", "null"], "maxLength": 300},
    "organization_public_name": {"type": ["string", "null"], "maxLength": 300},
    "signal_text_excerpt": {"type": "string", "minLength": 1, "maxLength": 1000},
    "object_detected": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "pain_detected": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "action_detected": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "decision_context": {"type": "string", "maxLength": 2000},
    "mapped_subject_id": {"type": ["string", "null"], "pattern": "^SE-SUBJ-[0-9]{6}$"},
    "mapped_state_id": {"type": ["string", "null"], "pattern": "^SE-ST-[0-9]{8}-[0-9]{6}$"},
    "score_components": {"type": "object", "additionalProperties": false, "required": ["real_problem", "action_intent", "specificity", "structurevidence_fit", "contactability"], "properties": {"real_problem": {"type": "integer", "minimum": 0, "maximum": 3}, "action_intent": {"type": "integer", "minimum": 0, "maximum": 2}, "specificity": {"type": "integer", "minimum": 0, "maximum": 2}, "structurevidence_fit": {"type": "integer", "minimum": 0, "maximum": 2}, "contactability": {"type": "integer", "minimum": 0, "maximum": 1}}},
    "real_decision_score": {"type": "integer", "minimum": 0, "maximum": 10},
    "score_class": {"enum": ["IGNORE", "WATCH", "QUALIFIED", "HIGH_VALUE"]},
    "contactability": {"enum": ["PUBLIC_REPLY", "FOLLOW", "MANUAL_DM", "WATCH", "SKIP"]},
    "recommended_action": {"enum": ["PUBLIC_REPLY", "FOLLOW", "MANUAL_DM", "WATCH", "SKIP"]},
    "contact_status": {"enum": ["NOT_REVIEWED", "APPROVED_FOR_CONTACT", "CONTACTED", "RESPONDED", "NO_RESPONSE", "DECLINED", "JOINED_RESEARCH_ROOM", "REQUEST_SUBMITTED", "CLOSED"]},
    "response_status": {"type": ["string", "null"], "maxLength": 80},
    "request_id": {"type": ["string", "null"], "maxLength": 100},
    "privacy_classification": {"const": "INTERNAL_ACQUISITION_SIGNAL"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
