{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structurevidence.org/schemas/se-frr/rdl-run.v0.1.json",
  "title": "RDL Run Provenance v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["rdl_run_id", "subject_id", "started_at", "ended_at", "trigger", "question", "research_level", "queries_executed", "sources_discovered", "sources_checked", "sources_rejected", "sources_used", "evidence_created", "counter_evidence_created", "unknowns_created", "unknowns_resolved", "state_before", "state_after", "decision_changed", "runtime_seconds", "compute_cost", "search_cost", "observed_credit_delta", "output_hash", "snapshot_hash"],
  "properties": {
    "rdl_run_id": {"type": "string", "minLength": 1}, "subject_id": {"type": "string", "pattern": "^SE-SUBJ-[0-9]{6}$"},
    "started_at": {"type": "string", "format": "date-time"}, "ended_at": {"type": "string", "format": "date-time"},
    "trigger": {"type": "string"}, "question": {"type": "string"},
    "research_level": {"enum": ["L0_SCAN", "L0_VERIFY", "L1_VERIFY", "L2_DEEP"]},
    "queries_executed": {"type": "array", "items": {"type": "string"}},
    "sources_discovered": {"type": "integer", "minimum": 0}, "sources_checked": {"type": "integer", "minimum": 0},
    "sources_rejected": {"type": "integer", "minimum": 0}, "sources_used": {"type": "integer", "minimum": 0},
    "evidence_created": {"type": "array", "items": {"type": "string"}}, "counter_evidence_created": {"type": "array", "items": {"type": "string"}},
    "unknowns_created": {"type": "array", "items": {"type": "string"}}, "unknowns_resolved": {"type": "array", "items": {"type": "string"}},
    "state_before": {"type": ["string", "null"]}, "state_after": {"type": ["string", "null"]}, "decision_changed": {"type": "boolean"},
    "runtime_seconds": {"type": ["number", "string"]},
    "compute_cost": {"anyOf": [{"type": "number", "minimum": 0}, {"const": "UNKNOWN"}]},
    "search_cost": {"anyOf": [{"type": "number", "minimum": 0}, {"const": "UNKNOWN"}]},
    "observed_credit_delta": {"anyOf": [{"type": "number"}, {"const": "UNKNOWN"}]},
    "output_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
