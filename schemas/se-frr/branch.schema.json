{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://structurevidence.org/schemas/se-frr/branch.v0.1.json", "title": "SE Branch v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "branch_id", "state_id", "subject_id", "created_at", "name", "description", "status", "required_conditions", "supporting_evidence_ids", "contradicting_evidence_ids", "strengthening_signals", "weakening_signals", "kill_conditions", "realization_evidence_ids", "visibility", "provenance"],
  "properties": {
    "schema_version": {"const": "SE_BRANCH_v0.1"}, "branch_id": {"type": "string", "pattern": "^SE-BR-[0-9]{8}-[0-9]{6}$"}, "state_id": {"type": "string", "minLength": 1}, "subject_id": {"type": "string", "pattern": "^SE-SUBJ-[0-9]{6}$"},
    "created_at": {"$ref": "#/$defs/timestamp"}, "name": {"type": "string", "minLength": 1}, "description": {"type": "string"}, "status": {"enum": ["POSSIBLE", "STRENGTHENING", "WEAKENING", "INVALIDATED", "REALIZED"]},
    "required_conditions": {"$ref": "#/$defs/strings"}, "supporting_evidence_ids": {"$ref": "#/$defs/strings"}, "contradicting_evidence_ids": {"$ref": "#/$defs/strings"}, "strengthening_signals": {"$ref": "#/$defs/strings"}, "weakening_signals": {"$ref": "#/$defs/strings"}, "kill_conditions": {"$ref": "#/$defs/strings"}, "realization_evidence_ids": {"$ref": "#/$defs/strings"},
    "visibility": {"$ref": "#/$defs/visibility"}, "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {"strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "timestamp": {"type": "string", "format": "date-time"}, "visibility": {"enum": ["PUBLIC", "FOUNDING_MEMBER", "CUSTOMER_PRIVATE", "INTERNAL"]}, "provenance": {"type": "object", "additionalProperties": false, "required": ["repository", "commit_sha", "source_object", "created_by", "method_version", "recorded_at", "supersedes", "superseded_by"], "properties": {"repository": {"type": "string", "minLength": 1}, "commit_sha": {"type": ["string", "null"]}, "source_object": {"type": ["string", "null"]}, "created_by": {"type": "string", "minLength": 1}, "method_version": {"type": "string", "minLength": 1}, "recorded_at": {"$ref": "#/$defs/timestamp"}, "supersedes": {"type": ["string", "null"]}, "superseded_by": {"type": ["string", "null"]}}}}
}
