{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structurevidence.org/schemas/case.schema.json",
  "title": "StructEvidence public case",
  "type": "object",
  "required": ["case_id", "title", "canonical_url", "question", "answer", "current_state", "as_of", "last_material_change", "evidence", "counter_evidence", "unknowns", "search_provenance", "history"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://structurevidence\\.org/cases/"},
    "question": {"type": "string", "minLength": 1},
    "answer": {"type": "string", "minLength": 1},
    "current_state": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "minLength": 10},
    "last_material_change": {"type": "string", "format": "date"},
    "evidence": {"type": "array", "items": {"$ref": "evidence.schema.json"}},
    "counter_evidence": {"type": "array", "items": {"type": "object"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "search_provenance": {"type": "array", "items": {"type": "object"}},
    "history": {"type": "array", "items": {"$ref": "state.schema.json"}},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "classifications", "published_at", "event_at", "retrieved_at", "state_changed", "url", "record_path"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "classifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "published_at": {"type": "string", "format": "date"},
          "event_at": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "state_changed": {"type": "boolean"},
          "url": {"type": "string", "format": "uri", "pattern": "^https://structurevidence\\.org/cases/"},
          "record_path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
